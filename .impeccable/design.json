    },
    {
      "name": "Passbook Lines",
      "kind": "custom",
      "refersTo": "panel",
      "description": "The coin book: date, description, debit, credit and saldo as printed lines with hairlines, amounts in tabular mono with sign and D/K labels.",
      "html": "<table class=\"ds-book\"><thead><tr><th>Tanggal</th><th>Keterangan</th><th class=\"r\">Debit</th><th class=\"r\">Kredit</th><th class=\"r\">Saldo</th></tr></thead><tbody><tr><td>9 Okt</td><td>Terlewat 9 Okt</td><td class=\"r debit\">&minus;50</td><td></td><td class=\"r\">950</td></tr><tr><td>9 Okt</td><td>Pot awal</td><td></td><td class=\"r credit\">+1.000</td><td class=\"r\">1.000</td></tr></tbody></table>",
      "css": ":host{--color-ground:oklch(0.966 0.007 145.5);--color-surface:oklch(0.985 0.004 145);--color-sunken:oklch(0.94 0.009 150);--color-rule:oklch(0.867 0.013 172.3);--color-rule-strong:oklch(0.6 0.02 180);--color-ink:oklch(0.244 0.025 191.3);--color-muted:oklch(0.44 0.02 190);--color-cover:oklch(0.322 0.048 192.9);--color-cover-ink:oklch(0.955 0.012 150);--color-primary:oklch(0.322 0.048 192.9);--color-primary-foreground:oklch(0.955 0.012 150);--color-stamp:oklch(0.457 0.215 277);--color-stamp-foreground:oklch(0.985 0.004 277);--color-stamp-tint:oklch(0.94 0.025 277);--color-stamp-text:oklch(0.457 0.215 277);--color-teal-tint:oklch(0.93 0.02 185);--color-debit:oklch(0.5 0.182 29.5);--color-credit:oklch(0.491 0.09 172.2);--color-today:oklch(0.924 0.115 95.7);--color-today-ink:oklch(0.244 0.025 191.3);--color-member-a:oklch(0.511 0.086 186.4);--color-member-b:oklch(0.459 0.17 3.8);font-family:Geist,ui-sans-serif,system-ui,sans-serif;font-size:15px;color:var(--color-ink)}.ds-book{width:100%;border-collapse:collapse;font-size:15px}.ds-book th{padding:8px 4px;border-bottom:1px solid var(--color-rule-strong);color:var(--color-muted);font-weight:500;font-size:13px;text-align:left}.ds-book td{padding:10px 4px;border-bottom:1px solid var(--color-rule);font-family:Geist Mono,ui-monospace,monospace;font-variant-numeric:tabular-nums}.ds-book td:nth-child(2){font-family:inherit}.ds-book .r{text-align:right}.ds-book .debit{color:var(--color-debit)}.ds-book .credit{color:var(--color-credit)}"
