    }
  ],
  "narrative": {
    "northStar": "Buku Tabungan",
    "overview": "Tepati is a bank passbook for a promise between two students. Every coin that moves is a dated, printed line with a debit, a credit and the saldo after it, and the saldo is always the sum of the lines above it. A deep passbook-cover teal owns the shell on a cool mint security paper; stamp violet, highlighter yellow, debit and credit are meaning colours, never decoration; the dark theme is the same book under a desk lamp.",
    "keyCharacteristics": [
      "One teal cover colour for chrome; four meaning colours that are never decorative.",
      "Geist for words, Geist Mono with tabular figures for every amount, date and countdown.",
      "Radius 6px on controls and 10px on panels, nothing else.",
      "Flat paper with hairline rules; a tinted shadow only on what floats.",
      "The passbook print: a line slides in, its digits type, the saldo rolls."
    ],
    "rules": [
      {
        "name": "The Coins-Only Rule",
        "body": "Red and green mean coins leaving and entering the pot. Never use them for a status, a check or a success message.",
        "section": "colors"
      },
      {
        "name": "The Stamp Rule",
        "body": "Violet is reserved for a human decision. If no person decided anything, it is not violet.",
        "section": "colors"
      },
      {
        "name": "The Only-Today Rule",
        "body": "Highlighter yellow marks today and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Fixed Line Rule",
        "body": "A member keeps the same line colour everywhere they appear.",
        "section": "colors"
      },
      {
        "name": "The Printed Number Rule",
        "body": "Every amount, date and countdown is Geist Mono with tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "Surfaces are flat at rest; depth appears only on what floats above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show a coin amount with its sign, the D or K label and the word.",
      "Do set every number, date and countdown in Geist Mono with tabular figures.",
      "Do keep violet for human decisions, yellow for today and the member colours fixed.",
      "Do draw icons from Phosphor in one weight, and give each status an icon and a word.",
      "Do underline text links; on touch there is no hover.",
      "Do respect reduced motion."
    ],
    "donts": [
      "Don't add streak flames, confetti, green-check heatmaps or gamified pastel cards.",
      "Don't use red or green for anything but coins, or violet for anything a person did not decide.",
      "Don't put the guilloche on the rail, panels or rows.",
      "Don't nest cards, add kickers above headings, or use gradient text, hard offset shadows or emoji icons.",
      "Don't compute the balance in the browser.",
      "Don't introduce a third radius or a colour outside the tokens."
    ]
  }
}
