# Tepati staging. Copy to deploy/env/.env.staging by hand and replace every CHANGE_ME.
# Generate secrets with: bun scripts/setup.ts --print-secret hex32   (or base64_32)

APP_ENV=staging
APP_BASE_URL=https://staging.CHANGE_ME
DOMAIN=staging.CHANGE_ME                      # Caddy obtains TLS for this host
ACME_EMAIL=CHANGE_ME
API_INTERNAL_URL=http://api:8080
API_PORT=8080
WEB_PORT=3000
SESSION_SECRET=CHANGE_ME
CLOCK_OVERRIDE=false

POSTGRES_USER=tepati
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tepati
DATABASE_URL=postgres://tepati:${POSTGRES_PASSWORD}@postgres:5432/tepati?sslmode=disable

REDIS_URL=redis://redis:6379/0

STORAGE_DRIVER=s3
UPLOAD_MODE=presigned
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=https://staging.CHANGE_ME/s3
S3_REGION=garage
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_STAGING=tepati-staging
S3_BUCKET_MEDIA=tepati-media
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_METRICS_TOKEN=CHANGE_ME
GARAGE_CAPACITY=50G

UPLOAD_IMAGE_MAX_BYTES=15728640
UPLOAD_VIDEO_MAX_BYTES=209715200
UPLOAD_VIDEO_MAX_SECONDS=180
UPLOAD_FILE_MAX_BYTES=20971520
UPLOAD_MAX_PER_PROOF=10
MEDIA_QUEUE_MAX=500

SMTP_URL=smtp://mailpit:1025                  # staging keeps Mailpit so no real mail leaves
MAIL_FROM="Tepati Staging <no-reply@staging.CHANGE_ME>"
ASYNQMON_BASIC_AUTH=CHANGE_ME:CHANGE_ME
