# Tepati environment for `bun run dev:docker` (apps inside Docker, using service hostnames).
# `bun run setup` copies this file to deploy/env/.env.dev. Never commit the copy.
# Infra-only values (ports, Postgres credentials, Garage secrets) are copied from
# the root .env, so hybrid and docker modes share one database and one Garage node.

APP_ENV=dev
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8080
API_PORT=8080
API_HOST_PORT=8080                            # where the host reaches the api container; change it if 8080 is taken
WEB_PORT=3000
SESSION_SECRET=__generate:hex32__
CLOCK_OVERRIDE=false

POSTGRES_USER=tepati
POSTGRES_PASSWORD=__from_root__
POSTGRES_DB=tepati
POSTGRES_PORT=5432
DATABASE_URL=postgres://tepati:${POSTGRES_PASSWORD}@postgres:5432/tepati?sslmode=disable

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

STORAGE_DRIVER=s3
UPLOAD_MODE=presigned
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_STAGING=tepati-staging
S3_BUCKET_MEDIA=tepati-media
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
GARAGE_RPC_SECRET=__from_root__
GARAGE_ADMIN_TOKEN=__from_root__
GARAGE_METRICS_TOKEN=__from_root__
GARAGE_CAPACITY=10G

UPLOAD_IMAGE_MAX_BYTES=15728640
UPLOAD_VIDEO_MAX_BYTES=209715200
UPLOAD_VIDEO_MAX_SECONDS=180
UPLOAD_FILE_MAX_BYTES=20971520
UPLOAD_MAX_PER_PROOF=10
MEDIA_QUEUE_MAX=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIPS_PATH=vips

SMTP_URL=smtp://mailpit:1025
MAIL_FROM="Tepati <no-reply@tepati.local>"
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

ASYNQMON_PORT=8081
WATCHPACK_POLLING=true                        # file watching through bind mounts (RUNNING.md §4.4)
AIR_POLL=1
AUTH_RATE_LIMIT_PER_MIN=200                   # dev only: the e2e suite signs in more than 10 times a minute
RATE_LIMIT_PER_MIN=3000
