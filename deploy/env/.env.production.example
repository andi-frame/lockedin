# Tepati production. Copy to deploy/env/.env.production by hand and replace every CHANGE_ME.
# Generate secrets with: bun scripts/setup.ts --print-secret hex32   (or base64_32)

APP_ENV=production
APP_BASE_URL=https://CHANGE_ME
DOMAIN=CHANGE_ME
ACME_EMAIL=CHANGE_ME
API_INTERNAL_URL=http://api:8080
API_PORT=8080
WEB_PORT=3000
SESSION_SECRET=CHANGE_ME
CLOCK_OVERRIDE=false

POSTGRES_USER=tepati
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tepati
DATABASE_URL=postgres://tepati:${POSTGRES_PASSWORD}@postgres:5432/tepati?sslmode=disable

REDIS_URL=redis://redis:6379/0

STORAGE_DRIVER=s3
UPLOAD_MODE=presigned
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=https://media.CHANGE_ME                 # the media host Caddy serves (a /s3 prefix would break presigned URLs)
S3_REGION=garage
S3_ACCESS_KEY=                                # left empty: the first deploy:up generates the pair and writes it here
S3_SECRET_KEY=
S3_BUCKET_STAGING=tepati-staging
S3_BUCKET_MEDIA=tepati-media
S3_BUCKET_BACKUPS=tepati-backups
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_METRICS_TOKEN=CHANGE_ME
GARAGE_CAPACITY=200G

UPLOAD_IMAGE_MAX_BYTES=15728640
UPLOAD_VIDEO_MAX_BYTES=209715200
UPLOAD_VIDEO_MAX_SECONDS=180
UPLOAD_FILE_MAX_BYTES=20971520
UPLOAD_MAX_PER_PROOF=10
MEDIA_QUEUE_MAX=500

SMTP_URL=smtps://CHANGE_ME:CHANGE_ME@smtp.CHANGE_ME:465
MAIL_FROM="Tepati <no-reply@CHANGE_ME>"
