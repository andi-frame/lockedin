# Overrides for `bun run dev:native` (no Docker). Copy to `.env.native` in the repo root (gitignored).
# It is layered over `.env`: put here only what differs for natively installed services.
# STORAGE_DRIVER is always `fs` in native mode (Garage has no Windows build); files go to FS_STORAGE_DIR.
#
# Needs PostgreSQL (18 recommended) with an empty database, Redis 7 or newer (Memurai or Redis in WSL;
# Redis 6 is refused by the pre-flight), ffmpeg and libvips on PATH. See docs/RUNNING.md section 7.
DATABASE_URL=postgres://tepati:CHANGE_ME@localhost:5432/tepati?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Only if a port is taken by something else (Docker's dev infra uses 55432 and 6379):
# API_PORT=18090
# API_INTERNAL_URL=http://localhost:18090
# WEB_PORT=3010
# APP_BASE_URL=http://localhost:3010
# WORKER_METRICS_PORT=9092
