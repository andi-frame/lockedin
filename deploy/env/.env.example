# Tepati environment, hybrid/native defaults (apps on the host, infra on localhost).
# `bun run setup` copies this file to `.env` at the repo root and fills every
# `__generate:*__` placeholder with a random value. Never commit the copy.

# --- app ---------------------------------------------------------------
APP_ENV=dev                                   # dev | staging | production
APP_BASE_URL=http://localhost:3000            # public origin the browser uses
API_INTERNAL_URL=http://localhost:8080        # Next.js server -> Go API
API_PORT=8080
WEB_PORT=3000
SESSION_SECRET=__generate:hex32__             # signs CSRF tokens; rotate = all sessions invalid
CLOCK_OVERRIDE=false                          # true enables the test clock endpoint (testclock builds only)

# --- postgres ----------------------------------------------------------
POSTGRES_USER=tepati
POSTGRES_PASSWORD=__generate:hex16__
POSTGRES_DB=tepati
POSTGRES_PORT=55432                            # high port so native Postgres installs (5432/5433) can coexist
DATABASE_URL=postgres://tepati:${POSTGRES_PASSWORD}@localhost:55432/tepati?sslmode=disable

# --- redis -------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- object storage (Garage, S3 API) -----------------------------------
STORAGE_DRIVER=s3                             # s3 | fs  (native mode forces fs)
FS_STORAGE_DIR=./.data/blobs                  # used when STORAGE_DRIVER=fs
UPLOAD_MODE=presigned                         # presigned | proxy (see ADR-0005)
S3_ENDPOINT=http://localhost:3900             # endpoint the server talks to
S3_PUBLIC_ENDPOINT=http://localhost:3900      # endpoint presigned URLs are signed for (browser-reachable)
S3_REGION=garage
S3_ACCESS_KEY=                                # written by `bun run garage:init`
S3_SECRET_KEY=                                # written by `bun run garage:init`
S3_BUCKET_STAGING=tepati-staging
S3_BUCKET_MEDIA=tepati-media
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
GARAGE_RPC_SECRET=__generate:hex32__          # must be exactly 32 bytes hex
GARAGE_ADMIN_TOKEN=__generate:base64_32__
GARAGE_METRICS_TOKEN=__generate:base64_32__
GARAGE_CAPACITY=10G                           # layout capacity for the single dev node

# --- uploads & media (SPEC §8) -----------------------------------------
UPLOAD_IMAGE_MAX_BYTES=15728640               # 15 MB
UPLOAD_VIDEO_MAX_BYTES=209715200              # 200 MB
UPLOAD_VIDEO_MAX_SECONDS=180
UPLOAD_FILE_MAX_BYTES=20971520                # 20 MB
UPLOAD_MAX_PER_PROOF=10
MEDIA_QUEUE_MAX=500                           # upload-intent returns 503 above this backlog
WORKER_CONCURRENCY=10                         # jobs the worker runs at once
WORKER_METRICS_PORT=9091                      # worker /metrics and /healthz; 0 disables (never expose publicly)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIPS_PATH=vips

# --- mail --------------------------------------------------------------
SMTP_URL=smtp://localhost:1025                # Mailpit in dev
MAIL_FROM="Tepati <no-reply@tepati.local>"
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- tools -------------------------------------------------------------
ASYNQMON_PORT=8081
