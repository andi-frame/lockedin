<!doctype html>
<html lang="id">
<body style="margin:0;padding:0;background:#f4f4f1;font-family:Geist,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2933;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f1;padding:24px 12px;">
<tr><td align="center">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:10px;overflow:hidden;">
<tr><td style="background:#0F766E;color:#ffffff;padding:16px 24px;font-size:18px;font-weight:600;">Tepati</td></tr>
<tr><td style="padding:24px;">
<p style="margin:0 0 12px;font-size:16px;">Halo {{.Name}},</p>
<h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;">{{.Heading}}</h1>
{{range .Lines}}<p style="margin:0 0 12px;font-size:15px;line-height:1.55;">{{.}}</p>
{{end}}{{if .URL}}<p style="margin:20px 0;"><a href="{{.URL}}" style="display:inline-block;background:#0F766E;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-size:15px;">{{.Action}}</a></p>
<p style="margin:0 0 12px;font-size:13px;color:#52606d;word-break:break-all;">Atau buka: {{.URL}}</p>
{{end}}</td></tr>
<tr><td style="padding:0 24px 24px;font-size:12px;line-height:1.5;color:#7b8794;">{{.Footer}}</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
